# Copy to .env and fill in.

# CILogon client registered for the origin with callback
#   https://localhost:8444/api/v1.0/auth/oauth/callback
# Its secret goes in secrets/cilogon-client-secret.
CILOGON_CLIENT_ID=cilogon:/client_id/REPLACE-ME

# Path to the Pelican checkout with the token-exchange patch applied.
PELICAN_SRC=./pelican

#For testing, the token exchange in scripts/test-token-exchange.sh
KC_REALM_URL=https://ndp-kc-test:9443/realms/NDP
KC_CLIENT_ID=jupyterhub_local
KC_CLIENT_SECRET=<fillin>

PELICAN_ID=<fillin>
PELICAN_SECRET=<fillin>

PELICAN_ORIGIN=https://localhost:8444